<Window x:Class="Parkereso.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Parkereso"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black"/>
                <GradientStop Color="#FF44FF00" Offset="1"/>
                <GradientStop Color="#FF040F00"/>
                <GradientStop Color="#FF020A00"/>
                <GradientStop Color="#FF21E7FF" Offset="0"/>
                <GradientStop Color="#FFD1F1C6" Offset="0.622"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="159*"/>
            <ColumnDefinition Width="41*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="valaszto_Grid" HorizontalAlignment="Left" Height="150" VerticalAlignment="Top" Width="159"/>
        <ListBox x:Name="ls_meret_valaszto" HorizontalAlignment="Left" Height="100" VerticalAlignment="Top" Width="159" Margin="0,13,0,0" Background="#FFFAEF35"/>
        <ListBox x:Name="ls_jatekmod" HorizontalAlignment="Left" Height="100" VerticalAlignment="Top" Width="159" Margin="346,13,0,0" Background="#FFFAEF35" />
        <Button x:Name="btn_start" Content="Start" HorizontalAlignment="Left" Margin="10,118,0,0" VerticalAlignment="Top" Width="117" Click="btn_start_Click" Background="#FF1FFFF7" Height="32" FontSize="24" FontWeight="Bold" FontFamily="Agency FB"/>
        <Grid x:Name="puzzle_Grid" HorizontalAlignment="Left" Width="780" Margin="10,155,0,29" Grid.ColumnSpan="2"/>
        <TextBlock x:Name="score_block" HorizontalAlignment="Left" Margin="164,28,0,0" TextWrapping="Wrap" Text="Próbák" VerticalAlignment="Top" Height="71" Width="182" FontSize="35" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Left" Margin="549,16,0,0" TextWrapping="Wrap" Text="Memória" VerticalAlignment="Top" Grid.ColumnSpan="2" Height="70" Width="251" FontSize="70" FontWeight="Bold" FontFamily="Agency FB">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black"/>
                    <GradientStop Color="#FFF3FF00" Offset="1"/>
                    <GradientStop Color="#FEFFFFFF" Offset="0.097"/>
                    <GradientStop Color="#FEFEFFF4" Offset="0.372"/>
                </LinearGradientBrush>
            </TextBlock.Foreground>
        </TextBlock>
    </Grid>
</Window>
